; THE WRLD OS visual style. Edit the values below, or copy this file under a new
; name (and change Name=) to create your own style. Colours are #RRGGBB or "none".

[Style]
Name=Plex
Renderer=plex
Description=Glossy black with blue highlights, after the Longhorn "Plex" style.
Wallpaper=Aurora

[Metrics]
title_h=28
border=5
cap_btn=19
menubar_h=20
taskbar_h=34

[Glass]
; Plex is opaque; "glass" is the blue accent glow used on title bars and the taskbar
glass=#3C8CFF
iglass=#5A6E8C
glass_alpha=255
iglass_alpha=255
glass_blur=0

