; THE WRLD OS visual style. Edit the values below, or copy this file under a new
; name (and change Name=) to create your own style. Colours are #RRGGBB or "none".

[Style]
Name=Plex
Renderer=plex
Description=Light blue Longhorn-era style: glossy sky-blue title bars, a pale taskbar and a blue Start menu.
Wallpaper=Azure

[Metrics]
title_h=26
border=3
cap_btn=18
menubar_h=20
taskbar_h=30

[Glass]
; Plex is opaque
glass=#5D97DF
iglass=#CCD8E8
glass_alpha=255
iglass_alpha=255
glass_blur=0

[Colors]
face=#EEF3F9
face_dark=#A4B4C8
face_light=#FFFFFF
window_bg=#FFFFFF
text=#000000
gray_text=#8A98AC
select=#3D7BD4
select_text=#FFFFFF
hot=#3D7BD4
hot_text=#FFFFFF
title_hi=#DCEBFC
title_top=#AFD0F6
title_mid=#80B1EA
title_bot=#5F97DE
ititle_hi=#F8FAFD
ititle_top=#E8EFF8
ititle_mid=#DAE4F0
ititle_bot=#CFDBEA
title_text=#FFFFFF
title_shadow=#3C6CAC
ititle_text=#6A7A90
frame_out=#4A78B4
frame_mid=#7AACE8
frame_in=#A9CDF5
iframe_out=#9AAAC0
iframe_mid=#CFDBEA
iframe_in=#E8EFF8
; caption buttons are bare glyphs; cap_bot/close_bot are the hover glows
cap_top=#FFFFFF
cap_bot=#A9CDF5
cap_border=none
cap_glyph=#F6FAFE
close_top=#F49A84
close_bot=#D8442A
tb_hi=#FFFFFF
tb_top=#EAF1FA
tb_mid=#DCE7F5
tb_bot=#C2D5EC
tb_text=#1E2E48
tray_hi=#FFFFFF
tray_top=#EAF1FA
tray_bot=#C2D5EC
tray_border=#93AED2
tray_text=#1E2E48
start_hi=#FFFFFF
start_top=#EAF1FA
start_bot=#C2D5EC
start_text=#1E2E48
start_shadow=none
tbtn_top=#F4F8FD
tbtn_bot=#D6E3F3
