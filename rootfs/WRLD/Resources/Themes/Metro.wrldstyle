; THE WRLD OS visual style. Edit the values below, or copy this file under a new
; name (and change Name=) to create your own style. Colours are #RRGGBB or "none".
; Metro: the flat look of Windows 8 - solid colour frames, square corners, no gradients.

[Style]
Name=Metro
Renderer=metro
Description=Flat, square and solid: frames in one accent colour, no gradients or glass.
Wallpaper=City lights

[Metrics]
title_h=30
border=6
cap_btn=21
menubar_h=20
taskbar_h=40

[Colors]
face=#F0F0F0
face_dark=#ABABAB
face_light=#FFFFFF
window_bg=#FFFFFF
text=#000000
gray_text=#6D6D6D
select=#3399FF
select_text=#FFFFFF
hot=#3399FF
hot_text=#FFFFFF
; title bar and frame are one flat colour
title_hi=#2B7BC4
title_top=#2B7BC4
title_mid=#2B7BC4
title_bot=#2B7BC4
ititle_hi=#EBEBEB
ititle_top=#EBEBEB
ititle_mid=#EBEBEB
ititle_bot=#EBEBEB
title_text=#FFFFFF
title_shadow=none
ititle_text=#8A8A8A
frame_out=#1F6AAE
frame_mid=#2B7BC4
frame_in=#2B7BC4
iframe_out=#ABABAB
iframe_mid=#EBEBEB
iframe_in=#EBEBEB
; caption buttons: min/max show only on hover, close is always red
cap_top=#4A94D8
cap_bot=#4A94D8
cap_border=#2B7BC4
cap_glyph=#FFFFFF
close_top=#C75050
close_bot=#C75050
