; THE WRLD OS visual style. Edit the values below, or copy this file under a new
; name (and change Name=) to create your own style. Colours are #RRGGBB or "none".

[Style]
Name=Aero
Renderer=aero
Description=Translucent blurred glass with a soft reflection.
Wallpaper=Aurora sky

[Metrics]
title_h=30
border=8
cap_btn=20
menubar_h=20
taskbar_h=40

[Glass]
; tint of active/inactive window glass, opacity 0-255, blur radius in pixels
glass=#74B8FC
iglass=#C4DCF4
glass_alpha=105
iglass_alpha=70
glass_blur=7

