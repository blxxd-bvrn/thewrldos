; Shaders for d3d10cube.c, in the assembly the HLSL compiler's disassembler
; prints. tools/dxbc_asm.py turns them into d3d10cube_shaders.h.
;
; cb0 rows: 0-3 world-view-projection (transposed), 4-7 world (transposed),
;           8 direction towards the light, 9.x time in seconds

shader g_vs
in  POSITION 0 0 xyz
in  NORMAL 0 1 xyz
in  TEXCOORD 0 2 xy
out SV_Position 0 0 xyzw position
out TEXCOORD 0 1 xy
out COLOR 0 2 xyzw
vs_4_0
dcl_constantbuffer cb0[10]
dcl_input v0.xyz
dcl_input v1.xyz
dcl_input v2.xy
dcl_output_siv o0.xyzw, position
dcl_output o1.xy
dcl_output o2.xyzw
dcl_temps 2
mov r1.xyz, v0.xyzx
mov r1.w, l(1.0)
dp4 o0.x, r1.xyzw, cb0[0].xyzw
dp4 o0.y, r1.xyzw, cb0[1].xyzw
dp4 o0.z, r1.xyzw, cb0[2].xyzw
dp4 o0.w, r1.xyzw, cb0[3].xyzw
dp3 r0.x, v1.xyzx, cb0[4].xyzx          ; the normal in world space
dp3 r0.y, v1.xyzx, cb0[5].xyzx
dp3 r0.z, v1.xyzx, cb0[6].xyzx
dp3 r0.w, r0.xyzx, r0.xyzx
rsq r0.w, r0.w
mul r0.xyz, r0.wwww, r0.xyzx
dp3_sat r0.x, r0.xyzx, cb0[8].xyzx      ; diffuse light
mad o2.xyzw, r0.xxxx, l(0.8, 0.8, 0.8, 0.0), l(0.25, 0.25, 0.25, 1.0)
mov o1.xy, v2.xyxx
ret

shader g_ps
in  SV_Position 0 0 xyzw position
in  TEXCOORD 0 1 xy
in  COLOR 0 2 xyzw
out SV_Target 0 0 xyzw
ps_4_0
dcl_constantbuffer cb0[10]
dcl_sampler s0
dcl_resource_texture2d (float,float,float,float) t0
dcl_input_ps linear v1.xy
dcl_input_ps linear v2.xyzw
dcl_output o0.xyzw
dcl_temps 2
sample r0.xyzw, v1.xyxx, t0.xyzw, s0
mul r0.xyzw, r0.xyzw, v2.xyzw
add r1.x, v1.x, v1.y                    ; a band of light sweeping over each face
add r1.x, r1.x, cb0[9].x
frc r1.x, r1.x
lt r1.y, r1.x, l(0.12)
if_nz r1.y
  mad r0.xyz, r0.xyzx, l(0.6, 0.6, 0.6, 0.0), l(0.4, 0.4, 0.4, 0.0)
endif
mov o0.xyzw, r0.xyzw
ret
